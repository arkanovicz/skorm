database example {

  schema bookshelf {

    table dude {
      !name varchar(100)
    }

    table author {
      name varchar(100)
    }

    table book {
      title varchar(100)
      genre enum('fiction', 'novel', 'essay', 'poetry')
      donor --> dude?
    }

    table borrowing {
      borrowing_date date
      restitution_date date?
    }

    table tag {
      label varchar(30)
    }

    // no chevron: both navigations (Book.author, Author.books)
    book *-- author
    // a chevron at the one side: the reference only, no collection on the other side
    borrowing -> book
    borrowing -> dude
    book *-* tag

  }

}
