#if($useInstantType)
@file:OptIn(kotlin.time.ExperimentalTime::class) // Instant is experimental below Kotlin 2.3

#end
package $package

import com.republicate.skorm.core.*
#if($resolved.mutableTwin)
import com.republicate.skorm.underlying
#foreach ($import in $resolved.mutableTwin.imports)
#if($import.mutable)
import ${import.destPackage}.createMissingSchemas
#end
#end
#end
#if(!$resolved.attributes.isEmpty())
import kotlinx.datetime.*
import com.republicate.kson.Json
#end
#if($useInstantType)
import kotlin.time.Instant
#end


// attribute registrations for core, called from initialize(): the read-only database's, then the mutable one's when it exists
internal #if($multiplatform)actual #{end}fun ${resolved.databaseClass}.registerAttributes() {
#foreach ($half in $resolved.halves)
#if($half.mutable)
    if (!${half.databaseClass}.isInstantiated()) return
#end
#foreach ($join in $half.joins)
    // $join.label attribute
    ${half.databaseClass}.${join.ownerSchema}.entity("$join.ownerEntity").instanceAttributes.${join.registration}<$join.targetClass>("$join.name", "$join.sql", $join.targetClass)
#end
#foreach ($attr in $half.attributes)

    // attribute $attr.qualifiedName
    ${half.databaseClass}.${attr.schema}${attr.registrationPath}.${attr.coreRegistration}("$attr.name", """
        $attr.sql""".trimIndent()#if($attr.factory), ${attr.factory}#{end})
#end
#end
}
#if($resolved.mutableTwin)

/**
 * Creates the schemas of this kddl schema when the database has none of them, those of its imports first:
 * true when anything was created. For an initialized database.
 */
suspend fun ${resolved.mutableTwin.databaseClass}.createMissingSchemas(): Boolean {
#foreach ($import in $resolved.mutableTwin.imports)
#if($import.mutable)
    val ${import.property}Created = ${import.property}.createMissingSchemas() // first: this one's tables reference its own
#end
#end
    val script = { ${resolved.mutableTwin.databaseClass}::class.java.getResource("/$scriptPath")!!.readText() }
    return (processor.underlying as CoreProcessor).createMissingSchemas(listOf(#foreach($schema in $resolved.schemas)"$schema.name"#if($foreach.hasNext), #end#end), script)#foreach ($import in $resolved.mutableTwin.imports)#if($import.mutable) || ${import.property}Created#end#end
}
#end
