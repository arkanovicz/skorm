package $package

import com.republicate.skorm.*


// navigations declaration for client: the read-only database's, then the mutable one's when it exists
fun ${resolved.databaseClass}.initJoins() {
#foreach ($half in $resolved.halves)
#if($half.mutable)
    if (!${half.databaseClass}.isInstantiated()) return
#end
#foreach ($join in $half.joins)
    // $join.label attribute
    ${half.databaseClass}.${join.ownerSchema}.entity("$join.ownerEntity").instanceAttributes.${join.registration}<$join.targetClass>("$join.name", setOf(#names($join.params)), $join.targetClass)
#end
#end
}
