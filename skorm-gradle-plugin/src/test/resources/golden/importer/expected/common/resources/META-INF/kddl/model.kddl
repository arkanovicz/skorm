import 'arkad.kddl'
database republicate {
  schema republicate {
    table decision {
      *id serial
      message -> arkad.message
      second -> arkad.message?
      outcome varchar(20)
    }
    table ballot {
      *id serial
      choice varchar(20)
      decision_id -- decision
    }
    table tag {
      *id serial
      name varchar(50)
    }
    table tag_room {
      *tag_id -> tag cascade
      *room_id -> arkad.room cascade
    }
  }
}
