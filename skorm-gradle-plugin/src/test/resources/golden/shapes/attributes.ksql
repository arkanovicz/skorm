// Frozen input for the golden-output tests: attribute shapes the bookshelf example does not reach.
database shapes {
  schema main {

    attr personCount: Int =
      SELECT count(*) FROM person;

    attr oldestBirth: LocalDate? =
      SELECT min(born) FROM person;

    attr summary: Json.Object =
      SELECT count(*) AS persons FROM person;

    attr everybody: Person* =
      SELECT * FROM person;

    attr Person.mainAddress: Address? =
      SELECT * FROM address WHERE owner = {person_id} LIMIT 1;

    // several statements: a transaction
    mut Person.forget = {
      DELETE FROM address WHERE owner = {person_id};
      DELETE FROM person WHERE person_id = {person_id};
    }

    attr Person.counts: (addresses: Int, friends: Int) =
      SELECT (SELECT count(*) FROM address WHERE owner = {person_id}) addresses,
             (SELECT count(*) FROM friendship WHERE a_id = {person_id}) friends;

    // a nullable composite field reads as nullable, its siblings stay non-null
    attr Person.profile: (name: String, born: LocalDate?) =
      SELECT name, born FROM person WHERE person_id = {person_id};

    // a composite of one field: a row with one named value, unlike a scalar flow
    attr Person.lastSeen: (seen: LocalDateTime?) =
      SELECT seen FROM person WHERE person_id = {person_id};

    // a scalar flow: the column's values themselves, harvested
    attr Person.cities: String* =
      SELECT city FROM address WHERE owner = {person_id};

    // a scalar flow of nullable values
    attr tinies: Int?* =
      SELECT tiny FROM person;

    // an Instant, as value and as argument: the generated files opt in to kotlin.time.ExperimentalTime
    attr stampedSince(since: Instant): Int =
      SELECT count(*) FROM person WHERE stamp >= {since};

    attr lastStamp: Instant? =
      SELECT max(stamp) FROM person;
  }
}
