// Frozen input for the golden-output tests: shapes the bookshelf example does not reach.
database shapes {

  schema main {

    enum level(low, high)

    table person {
      *person_id serial
      name varchar(50)
      rank level                           // named enum
      nature enum('a', 'b') as PersonNature // inline enum with an alias
      small smallint
      tiny tinyint?
      big biginteger?
      uid uuid?                            // each of these pulls in its own import
      meta json?
      doc jsonb?
      born date?
      seen timestamp?
      stamp timestamptz?
    }

    table country {
      *code char(2)                        // non-serial primary key
      label varchar(50)
    }

    table friendship {
      *a_id -- person                      // composite primary key, two links to the same table
      *b_id -- person
      since date
    }

    table gift {
      label varchar(20)
    }

    table address {
      *address_id serial
      city varchar(50)
      owner -- person                      // field link, both ways
      backup -> person?                    // field link, reference only
    }

    table student {
      *id serial                           // keyed like course and lesson: kddl names the link columns itself
      name varchar(20)
    }

    table course {
      *id serial
    }

    table lesson {
      *id serial
    }

    table vip : person                     // inheritance: Vip : Person, read polymorphically

    address *-- country                    // implicit column `code`, the country's key: Address.country()
    gift *-- friendship                    // multi-column foreign key
    person *-* address
    student *-* course                     // join table columns student_id, course_id
    lesson *-- course                      // implicit column course_id, where `id` is taken
  }

  schema other {
    table badge {
      label varchar(20)
    }
    badge *-- main.person                  // cross-schema link
  }
}
